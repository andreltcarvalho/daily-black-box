{
  "manifest_version": 3,
  "name": "Caixa Preta do Dia",
  "version": "0.1.0",
  "description": "Registra somente o domínio da aba em foco no aplicativo local.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Caixa Preta do Dia"
  }
}
